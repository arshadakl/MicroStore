# Supabase project (public values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# App URL (used by auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: v0 redirect proxy support
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Cloudinary — server-only, never prefix with NEXT_PUBLIC_
# Used by app/api/cloudinary/sign/route.ts to generate signed upload tokens.
# Get these from Cloudinary Dashboard > Settings > API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

